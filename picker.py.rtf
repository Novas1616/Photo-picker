\f0\fs24 \cf0 import os\
import shutil\
import stat\
\
# --- KONFIGURACE PRO MAC ---\
AUTHOR_NAME = "Michal Nov\'e1k" \
COPYRIGHT_TEXT = f"\'a9 2026 \{AUTHOR_NAME\}. All rights reserved."\
\
HOME = os.path.expanduser("~")\
WATCHED_FOLDER = os.path.join(HOME, "Pictures", "fotografie", "raw", "import")\
\
XMP_TEMPLATE = f"""<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 5.6-c140 79.160451, 2017/05/06-01:08:21">\
 <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">\
  <rdf:Description rdf:about="" xmlns:xmp="http://ns.adobe.com/xap/1.0/" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:xmpRights="http://ns.adobe.com/xap/1.0/rights/" xmp:Rating="5" xmpRights:Marked="True">\
   <dc:creator><rdf:Seq><rdf:li>\{AUTHOR_NAME\}</rdf:li></rdf:Seq></dc:creator>\
   <dc:rights><rdf:Alt><rdf:li xml:lang="x-default">\{COPYRIGHT_TEXT\}</rdf:li></rdf:Alt></dc:rights>\
  </rdf:Description>\
 </rdf:RDF>\
</x:xmpmeta>"""\
\
def get_exif_date(file_path):\
    # Rychle vyt\'e1hne z RAWu nebo JPG p\uc0\u345 esn\'e9 datum a \u269 as po\u345 \'edzen\'ed z EXIFu\
    try:\
        with open(file_path, 'rb') as f:\
            chunk = f.read(65536)\
            for i in range(len(chunk) - 19):\
                if chunk[i+4] == 58 and chunk[i+7] == 58 and chunk[i+10] == 32 and chunk[i+13] == 58:\
                    date_string = chunk[i:i+19].decode('utf-8', errors='ignore')\
                    if date_string.startswith(('202', '201')):\
                        return date_string\
    except Exception:\
        pass\
    \
    try:\
        return str(os.path.getmtime(file_path))\
    except Exception:\
        return "unknown"\
\
def find_lightroom_root():\
    # Automaticky najde slo\'9eku Lightroom autoimportu\
    possible_paths = [\
        os.path.join(HOME, "lightroom", "Auto Imported Photos"),\
        os.path.join(HOME, "Lightroom", "Auto Imported Photos"),\
        os.path.join(HOME, "Pictures", "Lightroom", "Auto Imported Photos"),\
        os.path.join(HOME, "Pictures", "Auto Imported Photos"),\
    ]\
    for path in possible_paths:\
        if os.path.exists(path):\
            return path\
            \
    for root, dirs, _ in os.walk(HOME):\
        if root.count(os.sep) - HOME.count(os.sep) > 2:\
            continue\
        for d in dirs:\
            if "auto imported photos" in d.lower():\
                return os.path.join(root, d)\
    return None\
\
def get_fast_index(final_destination_root):\
    # Vytvo\uc0\u345 \'ed nepr\u367 st\u345 eln\'fd index zalo\'9een\'fd na kombinaci: N\'e1zev_\u268 asEXIF\
    index = set()\
    \
    if final_destination_root and os.path.exists(final_destination_root):\
        print(f"\uc0\u55357 \u56589  Skenuji Lightroom knihovnu (\{final_destination_root\})...")\
        for root, _, files in os.walk(final_destination_root):\
            for f in files:\
                if f.lower().endswith(('.rw2', '.orf', '.jpg', '.jpeg')):\
                    path = os.path.join(root, f)\
                    exif_time = get_exif_date(path)\
                    index.add(f"\{f.lower()\}_\{exif_time\}")\
                    \
    if os.path.exists(WATCHED_FOLDER):\
        for f in os.listdir(WATCHED_FOLDER):\
            if f.lower().endswith(('.rw2', '.orf', '.jpg', '.jpeg')):\
                path = os.path.join(WATCHED_FOLDER, f)\
                exif_time = get_exif_date(path)\
                index.add(f"\{f.lower()\}_\{exif_time\}")\
                \
    return index\
\
def find_dcim_drives():\
    # Vyhled\'e1 p\uc0\u345 ipojen\'e9 SD karty v syst\'e9mu macOS ve slo\'9ece /Volumes\
    drives = []\
    volumes_path = "/Volumes"\
    if os.path.exists(volumes_path):\
        for disk in os.listdir(volumes_path):\
            drive_path = os.path.join(volumes_path, disk)\
            if os.path.isdir(drive_path) and os.path.exists(os.path.join(drive_path, "DCIM")):\
                drives.append(drive_path)\
    return drives\
\
def run_picker():\
    if not os.path.exists(WATCHED_FOLDER): \
        try:\
            os.makedirs(WATCHED_FOLDER)\
            os.chmod(WATCHED_FOLDER, 0o777)\
        except Exception as e:\
            print(f"\uc0\u10060  Nepoda\u345 ilo se vytvo\u345 it importn\'ed slo\'9eku: \{e\}")\
            return\
    \
    lrc_root = find_lightroom_root()\
    existing_index = get_fast_index(lrc_root)\
    drives = find_dcim_drives()\
    \
    if not drives:\
        print("\uc0\u8505 \u65039  Karta nezji\'9at\u283 na (slo\'9eka DCIM nenalezena v /Volumes).")\
        return\
\
    total_copied = 0\
    for drive in drives:\
        print(f"\uc0\u55357 \u56960  Skenuji kartu: \{os.path.basename(drive)\}...")\
        # OPRAVENO: Spr\'e1vn\uc0\u283  uzav\u345 en\'e1 z\'e1vorka pro os.walk\
        for root, _, files in os.walk(os.path.join(drive, "DCIM")):\
            for file in files:\
                if file.lower().endswith(('.rw2', '.orf', '.jpg', '.jpeg')):\
                    file_path = os.path.join(root, file)\
                    try:\
                        exif_time = get_exif_date(file_path)\
                        fingerprint = f"\{file.lower()\}_\{exif_time\}"\
\
                        if fingerprint in existing_index:\
                            continue\
\
                        f_info = os.stat(file_path)\
                        is_locked = not (f_info.st_mode & stat.S_IWRITE) or (hasattr(f_info, 'st_flags') and f_info.st_flags & stat.UF_IMMUTABLE)\
\
                        if is_locked:\
                            print(f"  \uc0\u55357 \u56568  FLAG / Z\'c1MEK: \{file\}")\
                            dest_path = os.path.join(WATCHED_FOLDER, file)\
                            shutil.copy2(file_path, dest_path)\
                            \
                            if hasattr(os, 'chflags'):\
                                os.chflags(dest_path, f_info.st_flags & ~stat.UF_IMMUTABLE)\
                            \
                            os.chmod(dest_path, 0o777)\
                            \
                            base_name = os.path.splitext(file)[0]\
                            xmp_path = os.path.join(WATCHED_FOLDER, base_name + ".xmp")\
                            with open(xmp_path, "w", encoding="utf-8") as xmp:\
                                xmp.write(XMP_TEMPLATE)\
                            \
                            os.chmod(xmp_path, 0o777)\
                            \
                            existing_index.add(fingerprint)\
                            total_copied += 1\
                    except Exception as e:\
                        print(f"\uc0\u9888 \u65039  Chyba u souboru \{file\}: \{e\}")\
                        continue\
\
    print("-" * 40)\
    print(f"\uc0\u55356 \u57281  Hotovo. Sta\'9eeno \{total_copied\} nov\'fdch fotek.")\
\
if __name__ == "__main__":\
    run_picker()}